@model Employee
@{
    ViewData["Title"] = "Usuń pracownika";
}

<div class="card card-soft mx-auto" style="max-width: 820px;">
    <div class="card-body p-4 p-md-5">
        <h1 class="page-title text-danger" style="font-size: 28px;">Usuń pracownika</h1>
        <p class="page-subtitle mb-4">Czy na pewno chcesz usunąć <strong>@Model.FullName</strong>?</p>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="actions-row">
                <button type="submit" class="btn btn-danger">Usuń</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>
