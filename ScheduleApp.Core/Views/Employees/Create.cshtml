@model Employee
@{
    ViewData["Title"] = "Dodaj pracownika";
}

<div class="card card-soft mx-auto" style="max-width: 820px;">
    <div class="card-body p-4 p-md-5">
        <h1 class="page-title" style="font-size: 28px;">Dodaj pracownika</h1>
        <p class="page-subtitle mb-4">Wypełnij dane, aby dodać pracownika do harmonogramu.</p>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsContractZlecenie" class="form-check-input" type="checkbox" />
                        <label asp-for="IsContractZlecenie" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContractMonths" class="form-label"></label>
                    <input asp-for="ContractMonths" type="number" step="1" class="form-control" />
                    <span asp-validation-for="ContractMonths" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NormHours" class="form-label"></label>
                    <input asp-for="NormHours" type="number" step="0.5" class="form-control" />
                    <span asp-validation-for="NormHours" class="text-danger"></span>
                </div>
            </div>
            <div class="actions-row">
                <button type="submit" class="btn btn-primary">Zapisz</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
