@model ScheduleEntryEditViewModel
@{
    ViewData["Title"] = "Edytuj plan pracy";
}

<div class="form-shell">
    <div class="form-toolbar">
        <a asp-action="Index" class="back-link">←</a>
        <h1 class="page-title" style="font-size: 28px;">Edytuj plan pracy</h1>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-grid">
            <section class="section-card">
                <h3 class="section-title">Pracownik</h3>
                <div class="mb-4">
                    <label class="section-label">Wybierz pracownika</label>
                    <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select"></select>
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                </div>

                <h3 class="section-title">Okres i typ dnia</h3>
                <div class="d-grid gap-3">
                    <div>
                        <label class="section-label">Data od</label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                    <div>
                        <label class="section-label">Data do</label>
                        <input asp-for="Date" type="date" class="form-control" />
                    </div>
                    <div>
                        <label class="section-label">Typ dnia</label>
                        <select asp-for="Type" asp-items="Model.TypeOptions" class="form-select"></select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="section-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="section-title mb-0">Plan dnia</h3>
                    <a href="#" class="link-primary text-decoration-none">+ Dodaj pozycję</a>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="section-label">Godz. od</label>
                        <input id="startHourDisplay" type="time" class="form-control" />
                        <input asp-for="StartHour" type="hidden" />
                        <span asp-validation-for="StartHour" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="section-label">Godz. do</label>
                        <input id="endHourDisplay" type="time" class="form-control" />
                        <input asp-for="EndHour" type="hidden" />
                        <span asp-validation-for="EndHour" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="section-label">Rodzaj pracy</label>
                    <select asp-for="Type" asp-items="Model.TypeOptions" class="form-select"></select>
                </div>

                <div class="mb-3">
                    <label class="section-label">Uwagi</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <a href="#" class="link-primary text-decoration-none">Pokaż szczegóły</a>
            </section>
        </div>

        <div class="actions-row">
            <button type="submit" class="btn btn-primary">Zapisz</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    // Initialize time display from decimal values
    function initializeTimes() {
        var startHourValue = document.querySelector('input[name="StartHour"]').value;
        var endHourValue = document.querySelector('input[name="EndHour"]').value;
        
        if (startHourValue) {
            document.getElementById('startHourDisplay').value = decimalToTimeFormat(parseFloat(startHourValue));
        }
        if (endHourValue) {
            document.getElementById('endHourDisplay').value = decimalToTimeFormat(parseFloat(endHourValue));
        }
    }

    // Convert HH:MM format to decimal hours (use locale decimal separator)
    function timeFormatToDecimal(timeStr) {
        if (!timeStr) return '';
        var parts = timeStr.split(':');
        var hours = parseInt(parts[0], 10);
        var minutes = parseInt(parts[1], 10);
        var dec = (hours + minutes / 60).toFixed(2);
        // Use user's locale decimal separator (comma for pl-PL)
        var separator = (1.1).toLocaleString().substring(1,2);
        if (separator !== '.') {
            dec = dec.replace('.', separator);
        }
        return dec;
    }

    // Convert decimal hours to HH:MM format
    function decimalToTimeFormat(decimal) {
        if (!decimal) return '';
        var hours = Math.floor(decimal);
        var minutes = Math.round((decimal - hours) * 60);
        return (hours < 10 ? '0' : '') + hours + ':' + (minutes < 10 ? '0' : '') + minutes;
    }

    // Update hidden fields on form submit
    document.querySelector('form').addEventListener('submit', function(e) {
        var startTimeStr = document.getElementById('startHourDisplay').value;
        var endTimeStr = document.getElementById('endHourDisplay').value;
        
        if (startTimeStr) {
            document.querySelector('input[name="StartHour"]').value = timeFormatToDecimal(startTimeStr);
        }
        if (endTimeStr) {
            document.querySelector('input[name="EndHour"]').value = timeFormatToDecimal(endTimeStr);
        }
    });

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', initializeTimes);
    </script>
}

<!-- scripts section already defined above -->
