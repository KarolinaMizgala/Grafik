</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        function timeFormatToDecimal(timeStr) {
            if (!timeStr) return '';
            var parts = timeStr.split(':');
            var hours = parseInt(parts[0], 10);
            var minutes = parseInt(parts[1], 10);
            if (isNaN(hours) || isNaN(minutes)) return '';
            // Send invariant decimal format to backend, e.g. 8.50
            var dec = (hours + minutes / 60).toFixed(2);
            return dec;
        }

        function pad2(value) {
            return value < 10 ? '0' + value : '' + value;
        }

        function parseDecimal(value) {
            if (value === null || value === undefined || value === '') {
                return null;
            }
            var normalized = String(value).trim().replace(',', '.');
            var parsed = Number.parseFloat(normalized);
            return Number.isFinite(parsed) ? parsed : null;
        }

        function decimalToTimeFormat(decimal) {
            var parsed = parseDecimal(decimal);
            if (parsed === null) return '';

            var hours = Math.floor(parsed);
            var minutes = Math.round((parsed - hours) * 60);
            if (minutes === 60) {
                hours += 1;
                minutes = 0;
            }

            return pad2(hours) + ':' + pad2(minutes);
        }

        // Otwieranie modal
        document.querySelectorAll('[data-bs-toggle="modal"][data-bs-target="#scheduleFormModal"]').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                var employeeId = this.getAttribute('data-employee-id');
                var date = this.getAttribute('data-date');
                var entryId = this.getAttribute('data-entry-id');
                var employeeName = this.getAttribute('data-employee-name');

                document.getElementById('scheduleEmployeeId').value = employeeId;
                document.getElementById('scheduleDate').value = date;
                document.getElementById('scheduleEntryId').value = entryId || '';
                document.getElementById('scheduleEmployeeName').value = employeeName;
                document.getElementById('scheduleStartDate').value = date;
                document.getElementById('scheduleEndDate').value = date;
                // reset batch mode toggle
                document.getElementById('batchMode').checked = false;

                // Jeśli edycja - załaduj dane
                if (entryId && entryId !== '0') {
                    var startHour = this.getAttribute('data-start-hour');
                    var endHour = this.getAttribute('data-end-hour');
                    var type = this.getAttribute('data-type');
                    var notes = this.getAttribute('data-notes');

                    document.getElementById('startHourDisplay').value = startHour !== null && startHour !== '' ? decimalToTimeFormat(startHour) : '';
                    document.getElementById('endHourDisplay').value = endHour !== null && endHour !== '' ? decimalToTimeFormat(endHour) : '';
                    document.getElementById('scheduleType').value = type || 'Normal';
                    document.getElementById('scheduleNotes').value = notes || '';
                } else {
                    // Nowy wpis
                    document.getElementById('scheduleForm').reset();
                    document.getElementById('scheduleEmployeeId').value = employeeId;
                    document.getElementById('scheduleDate').value = date;
                    document.getElementById('scheduleEmployeeName').value = employeeName;
                    document.getElementById('scheduleStartDate').value = date;
                    document.getElementById('scheduleEndDate').value = date;
                    document.getElementById('scheduleType').value = 'Normal';
                }
            });
        });

        // Obsługa formularza
        document.getElementById('scheduleForm').addEventListener('submit', function(e) {
            e.preventDefault();

            var startTimeStr = document.getElementById('startHourDisplay').value;
            var endTimeStr = document.getElementById('endHourDisplay').value;
            var entryId = document.getElementById('scheduleEntryId').value;
            var employeeId = document.getElementById('scheduleEmployeeId').value;
            var date = document.getElementById('scheduleDate').value;
            var batchMode = document.getElementById('batchMode').checked;
            var type = document.getElementById('scheduleType').value;

            // Walidacja - godziny wymagane dla Normal i Noc
            if ((type === 'Normal' || type === 'Noc') && (!startTimeStr || !endTimeStr)) {
                alert('Dla typu dnia "' + type + '" wymagane są godziny od i do');
                return;
            }

            // Konwersja czasu - dla Urlop/Zwolnienie chorobowe może być pusty
            if (startTimeStr && endTimeStr) {
                document.getElementById('startHour').value = timeFormatToDecimal(startTimeStr);
                document.getElementById('endHour').value = timeFormatToDecimal(endTimeStr);
            } else {
                document.getElementById('startHour').value = '';
                document.getElementById('endHour').value = '';
            }

            var formData = new FormData(this);
            var action;
            if (batchMode) {
                action = '/Schedules/CreateBatch';
                // ensure start/end dates are present
                var s = document.getElementById('scheduleStartDate').value;
                var e = document.getElementById('scheduleEndDate').value;
                if (!s || !e) {
                    alert('Wprowadź datę początku i końca zakresu');
                    return;
                }
            } else {
                action = (entryId && entryId !== '0') ? '/Schedules/Edit/' + entryId : '/Schedules/Create';
            }

            fetch(action, {
                method: 'POST',
                body: formData
            }).then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Błąd przy zapisywaniu');
                }
            }).catch(err => {
                console.error('Error:', err);
                alert('Błąd sieci');
            });
        });

        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (element) {
            new bootstrap.Tooltip(element);
        });

        document.querySelectorAll('.planner-day-summary').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                var day = this.getAttribute('data-day');
                var entries = JSON.parse(this.getAttribute('data-entries') || '[]');
                var labels = JSON.parse(this.getAttribute('data-labels') || '[]');
                var counts = JSON.parse(this.getAttribute('data-counts') || '[]');
                document.getElementById('dayEmployeesDate').textContent = day;

                var body = document.getElementById('dayEmployeesBody');
                var empty = document.getElementById('dayEmployeesEmpty');
                body.innerHTML = '';

                if (!entries.length) {
                    empty.classList.remove('d-none');
                } else {
                    empty.classList.add('d-none');
                    entries.forEach(function(item) {
                        var row = document.createElement('tr');
                        row.innerHTML = '<td class="fw-semibold"></td><td></td><td></td><td></td>';
                        row.children[0].textContent = item.EmployeeName || '';
                        row.children[1].textContent = (item.Start || '') + ' - ' + (item.End || '');
                        row.children[2].textContent = item.Type || '';
                        row.children[3].textContent = item.Notes || '';
                        body.appendChild(row);
                    });
                }
                // render 24h chart
                renderDayChart(labels, counts);
                // show modal (bootstrap handles show via data-bs-toggle)
            });
        });

        var dayChart = null;
        function renderDayChart(labels, counts) {
            var ctx = document.getElementById('dayEmployeesChart').getContext('2d');
            if (dayChart) { dayChart.destroy(); }
            dayChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Pracujących',
                        data: counts,
                        backgroundColor: 'rgba(54, 162, 235, 0.45)',
                        borderColor: 'rgba(54, 162, 235, 0.8)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            grid: { display: true },
                            ticks: {
                                autoSkip: false,
                                maxRotation: 90,
                                minRotation: 0,
                                callback: function(value, index, ticks) { return this.getLabelForValue(index); }
                            }
                        },
                        y: { beginAtZero: true, precision:0 }
                    },
                    plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } }
                }
            });
        }

        // Export to PDF
        var exportPdfBtn = document.getElementById('exportPdfBtn');
        if (exportPdfBtn) {
            exportPdfBtn.addEventListener('click', function() {
                var element = document.querySelector('.planner-board');
                var monthKey = '@monthStart.ToString("yyyy-MM")';
                var fileName = 'Harmonogram_' + monthKey.replace('-', '_') + '.pdf';
                var daysCount = @days.Count;
                var employeeColumnWidth = 170;
                var dayColumnWidth = 28;
                var gapSize = 2;

                if (!element) {
                    return;
                }

                var pdfHost = document.createElement('div');
                pdfHost.className = 'planner-pdf-host';

                // Create a copy of the board for PDF
                var clonedBoard = element.cloneNode(true);
                clonedBoard.classList.add('planner-pdf-export');
                clonedBoard.style.width = (employeeColumnWidth + (daysCount * dayColumnWidth) + ((daysCount + 1) * gapSize)) + 'px';
                // html2canvas (used by html2pdf.js) does not support CSS Grid, so the clone
                // is switched to flexbox here or every row collapses to zero height in the PDF.
                clonedBoard.querySelectorAll('.planner-row').forEach(function(row) {
                    row.style.display = 'flex';
                    row.style.flexWrap = 'nowrap';
                    row.style.gridTemplateColumns = '';
                    row.style.gap = gapSize + 'px';
                    row.style.marginBottom = '2px';
                    if (row.firstElementChild) {
                        row.firstElementChild.style.width = employeeColumnWidth + 'px';
                        row.firstElementChild.style.minWidth = employeeColumnWidth + 'px';
                        row.firstElementChild.style.flex = '0 0 auto';
                    }
                });
                clonedBoard.querySelectorAll('.planner-head-cell, .planner-cell').forEach(function(cell) {
                    cell.style.width = dayColumnWidth + 'px';
                    cell.style.minWidth = dayColumnWidth + 'px';
                    cell.style.flex = '0 0 auto';
                    cell.style.borderRadius = '0';
                });
                clonedBoard.querySelectorAll('.planner-employee-card').forEach(function(card) {
                    card.style.width = employeeColumnWidth + 'px';
                    card.style.minWidth = employeeColumnWidth + 'px';
                    card.style.flex = '0 0 auto';
                    card.style.borderRadius = '0';
                });
                clonedBoard.querySelectorAll('.planner-cell-button').forEach(function(button) {
                    button.style.pointerEvents = 'none';
                    button.style.cursor = 'default';
                    button.removeAttribute('data-bs-toggle');
                    button.removeAttribute('data-bs-target');

                    var type = button.getAttribute('data-type') || 'Normal';
                    var isZlecenie = button.getAttribute('data-employee-zlecenie') === '1';
                    var startHour = button.getAttribute('data-start-hour');
                    var hasEntry = button.getAttribute('data-entry-id') && button.getAttribute('data-entry-id') !== '0';
                    var isAutoHoliday = button.classList.contains('planner-cell-holiday') && !hasEntry;
                    var main = '';
                    var sub = '';

                    if (hasEntry && (type === 'Normal' || type === 'Noc') && startHour) {
                        main = decimalToTimeFormat(startHour) || '';
                        if (isZlecenie) {
                            sub = 'ZL';
                        }
                    } else if (hasEntry && (type === 'Wolne' || type === 'Urlop' || type === 'Święto')) {
                        main = 'W';
                    } else if (hasEntry && type === 'Zwolnienie chorobowe') {
                        main = 'L4';
                    } else if (isAutoHoliday) {
                        // Automatycznie wykryta niedziela/święto bez wpisu
                        main = 'W';
                    }

                    var warningWrap = button.querySelector('.planner-cell-warning-wrap');
                    button.innerHTML = '';
                    var mainDiv = document.createElement('div');
                    mainDiv.className = 'planner-cell-main';
                    mainDiv.textContent = main;
                    button.appendChild(mainDiv);
                    if (sub) {
                        var subDiv = document.createElement('div');
                        subDiv.className = 'planner-cell-sub';
                        subDiv.textContent = sub;
                        button.appendChild(subDiv);
                    }
                    if (warningWrap) {
                        button.appendChild(warningWrap);
                    }
                });

                clonedBoard.querySelectorAll('.planner-employee-summary, .planner-day-summary, #exportPdfBtn, .planner-controls, .planner-menu-btn, .dropdown, .modal, .app-topbar, .app-sidebar').forEach(function(el) {
                    el.style.display = 'none';
                });
                
                pdfHost.appendChild(clonedBoard);
                document.body.appendChild(pdfHost);
                
                var opt = {
                    margin: [6, 6, 6, 6],
                    filename: fileName,
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true },
                    jsPDF: { orientation: 'landscape', unit: 'mm', format: 'a3' },
                    pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
                };
                
                html2pdf().set(opt).from(pdfHost).save().finally(function() {
                    if (pdfHost && pdfHost.parentNode) {
                        pdfHost.parentNode.removeChild(pdfHost);
                    }
                });
            });
        }
    </script>
}
